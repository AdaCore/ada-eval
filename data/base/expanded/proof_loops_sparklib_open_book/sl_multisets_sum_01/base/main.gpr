with "sparklib.gpr";

project Main is
   for Source_Dirs use ("src");
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj";

   package Compiler is
      --  -gnat2022 is the one switch in SPARKlib's own sparklib_common.gpr
      --  that changes what compiles; the others are style (-gnatygo-u) and a
      --  warning filter (-gnatwI).
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;

   package Builder is
      for Global_Configuration_Pragmas use "main.adc";
   end Builder;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--no-subprojects");
   end Prove;
end Main;
