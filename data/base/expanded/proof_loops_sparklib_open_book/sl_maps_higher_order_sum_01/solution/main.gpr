with "sparklib.gpr";
project Main is
   for Source_Dirs use ("src");
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj";
   package Compiler is
      for Switches ("ada") use ("-gnat2022");
   end Compiler;
   package Builder is
      for Global_Configuration_Pragmas use "main.adc";
   end Builder;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=1", "--no-subprojects");
   end Prove;
end Main;
