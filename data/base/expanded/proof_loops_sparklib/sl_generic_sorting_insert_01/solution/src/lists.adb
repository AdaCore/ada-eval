pragma Ada_2022;

package body Lists with SPARK_Mode
is

   procedure Insert
     (Container : in out List;
      Before    : Cursor;
      New_Item  : Element_Type;
      Position  : out Cursor;
      Count     : Count_Type)
   is separate;

end Lists;
