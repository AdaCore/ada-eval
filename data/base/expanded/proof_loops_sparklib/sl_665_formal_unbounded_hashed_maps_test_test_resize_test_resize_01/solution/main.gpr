with "sparklib.gpr";
project Main is
   for Source_Dirs use ("src");
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj";

   --  Upstream's test.gpr: ("-gnat2022", "-gnata").
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=1", "--no-subprojects");
   end Prove;
end Main;
