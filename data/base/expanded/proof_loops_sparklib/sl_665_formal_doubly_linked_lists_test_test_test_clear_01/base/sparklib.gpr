--  SPARKlib for this project.
--
--  The installed sparklib.gpr puts its object and library directories inside
--  the SPARK installation, which is not writable.  As the template
--  sparklib.gpr.templ recommends, this copy points Object_Dir at a directory
--  inside the project.
project SPARKlib extends "sparklib_internal" is
   for Object_Dir use "sparklib_obj";
   for Source_Dirs use SPARKlib_Internal'Source_Dirs;
   for Excluded_Source_Files use SPARKlib_Internal'Excluded_Source_Files;
end SPARKlib;
