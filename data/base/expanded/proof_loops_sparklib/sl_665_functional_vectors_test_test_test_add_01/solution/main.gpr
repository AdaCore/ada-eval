with "sparklib.gpr";
project Main is
   for Source_Dirs use ("src");
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj";

   package Compiler is
      --  Upstream's test.gpr compiles with -gnat2022; SPARKlib's own specs
      --  need it too.
      for Switches ("Ada") use ("-gnat2022");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=1", "--no-subprojects");
   end Prove;
end Main;
