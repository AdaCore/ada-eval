with "sparklib.gpr";
project Main is
   for Source_Dirs use ("src");
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj";

   package Compiler is
      --  Upstream's memcp.gpr names this same file with the same attribute.
      --  Its pragma Ada_2022 is what SPARKlib's Unbounded_Vectors specs need,
      --  so no -gnat2022 switch is repeated here.
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=1", "--no-subprojects");
   end Prove;
end Main;
